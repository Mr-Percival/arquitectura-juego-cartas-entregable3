@startuml despliegue
' Diagrama UML de despliegue del MVP - Entregable 3
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50
skinparam node {
  BorderColor #2F4A6D
  BackgroundColor #F7F9FC
}
skinparam artifact {
  BorderColor #2F4A6D
  BackgroundColor #FFFFFF
}
skinparam database {
  BorderColor #2F4A6D
  BackgroundColor #EEF3FA
}
skinparam ArrowColor #2F4A6D

node "Dispositivo del jugador\n(celular o PC)" as disp <<device>> {
  node "Navegador web\n(Chrome, Safari, Firefox)" as nav <<executionEnvironment>> {
    artifact "index.html\n(HTML + CSS + JS en línea)" as html
  }
}

cloud "Render (nube)" as render {
  node "Servicio web «juego-cartas»\n(plan free, health check GET /salud)" as svc <<device>> {
    node "Contenedor Docker\npython:3.12-slim" as cont <<executionEnvironment>> {
      node "uvicorn (ASGI)\n0.0.0.0:$PORT" as uv <<executionEnvironment>> {
        artifact "paquete juegocartas\n(FastAPI: GET /, GET /salud,\nGET /bitacora/{codigo}.csv, WS /ws)" as app
        artifact "plug-ins CLASICA_433\ny APUNTADO_101\n(entry points)" as plug
        artifact "esquema.sql +\ndatos_iniciales.sql" as sql
      }
    }
  }
  node "PostgreSQL 16 gestionado\n«juego-cartas-db» (plan free)" as pgnode <<device>> {
    database "base de datos\n(esquema del E2)" as pg
  }
}

cloud "GitHub" as gh {
  artifact "repositorio\n(rama main)" as repo
  node "GitHub Actions\n(ubuntu-latest)" as ga <<executionEnvironment>> {
    artifact "fitness-functions.yml\n(pytest + métricas +\ndocker compose up)" as wf
  }
}

artifact "imagen Docker\n(Dockerfile)" as img

nav --> svc : HTTPS :443\n(GET / , GET /bitacora/*.csv)
nav <--> svc : WSS :443 /ws\n(JSON: acciones y vistas)
app --> pg : TCP :5432, protocolo PostgreSQL\n(psycopg 3; DATABASE_URL interna\nde la red privada de Render)
plug ..> app : <<cargados por\nPluginRegistry>>
repo --> ga : push / pull_request\n(dispara el workflow)
repo --> render : push a main\n(auto-deploy de Render)
img ..> cont : <<deploy>>
repo ..> img : docker build

node "PC de desarrollo (alterno local)" as local <<device>> {
  node "docker compose" as dc <<executionEnvironment>> {
    node "contenedor web\n:8000" as lweb <<executionEnvironment>>
    node "contenedor db\npostgres:16-alpine" as ldb <<executionEnvironment>>
  }
}
lweb --> ldb : TCP :5432 (red interna,\nsin TLS)
ldb -[hidden]- local
@enduml
